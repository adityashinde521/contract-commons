---
import Base from '../layouts/Base.astro';
import { MODULES, PATHS, TINT, url } from '../lib/course';
---
<Base title="Learning paths" active="paths">
  <div class="wrap">
    <header class="page-head">
      <div class="cc-eyebrow">Learning paths</div>
      <h1>Choose the path that fits your goal</h1>
      <p class="lead">Every path starts with the same foundations, then goes deeper where your discipline needs it. Choose a path to see it on My progress. You can change it at any time.</p>
    </header>
    <div style="display:flex;flex-direction:column;gap:18px;margin-top:24px">
      {PATHS.map((p) => (
        <section class={`path-card ${p.tint}`} id={p.id}>
          <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:flex-start">
            <div style="max-width:640px"><h2 style="margin:0;font-size:24px;font-weight:800">{p.title}</h2><p style="margin:6px 0 0">{p.text}</p><p class="k" style="margin-top:8px">Main tools: {p.tools}</p></div>
            <button class="cc-btn cc-btn--primary" type="button" data-choose-path={p.id}>Choose this path</button>
          </div>
          <ol style="list-style:none;margin:8px 0 0;padding:0;display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
            {p.modules.map((n) => { const m = MODULES.find((x) => x.n === n)!; return (
              <li><a href={url(`/modules/${m.slug}/`)} style="display:flex;gap:10px;align-items:center;background:var(--surface);border-radius:12px;padding:10px 12px;text-decoration:none;color:var(--ink)"><span class={`mod-num ${TINT[m.tint]}`} style="width:34px;height:34px;font-size:13px">{String(m.n).padStart(2,'0')}</span><span style="font-weight:600;font-size:14.5px">{m.title}</span></a></li>
            ); })}
          </ol>
        </section>
      ))}
    </div>
    <section class="cc-card" style="margin-top:24px;border-radius:var(--radius-xl)">
      <h2 style="margin:0 0 6px;font-size:20px">Not sure?</h2>
      <p style="margin:0 0 12px;color:var(--muted)">Take the 10-question placement check. It suggests a path and the first module to open.</p>
      <a class="cc-btn cc-btn--secondary" href={url('/placement/')}>Take the placement check</a>
    </section>
  </div>
</Base>
