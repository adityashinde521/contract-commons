---
import Base from '../layouts/Base.astro';
import { MODULES, PATHS, TINT, orderedLessons, url } from '../lib/course';
const lessons = await orderedLessons();
const codeLabs = lessons.filter((l) => l.entry.data.kind === 'lab-remix').length;
const toolLabs = lessons.filter((l) => l.entry.data.kind === 'lab-gui').length;
const firstLab = (n: number) => lessons.find((l) => l.mod.n === n && l.entry.data.kind.startsWith('lab'));
const steps = [
  ['01', 'Problem', 'A real case: a purchase between strangers, a lost key, a 2025 hack.'],
  ['02', 'Concept', 'The idea behind it, in plain words, with tables, key terms and sources.'],
  ['03', 'Build', 'Do it yourself in Remix or a market tool, with the expected result for every step.'],
  ['04', 'Apply', 'The same contract seen by CS, business and law, with questions for your team.'],
  ['05', 'Ship', 'Something you keep: a verified contract, an Etherscan link, a lab log entry, a passed quiz.'],
];
const tools = [['Remix','Write and deploy'],['MetaMask','Test wallet'],['OpenZeppelin','Audited building blocks'],['Foundry','Testing'],['thirdweb','Ready-made contracts'],['Safe','Multisig'],['Aragon','DAOs'],['EAS','Attestations'],['Tenderly','Debug and simulate'],['Phalcon','Trace real hacks'],['Dune','On-chain data'],['L2BEAT','Rollup risk']];
const personas = [
  { t: 'I study law', d: 'No code. Learn the technology, then run real contracts with GUI tools and analyse them legally.', chips: ['Legal-tech path', 'No programming'], href: '/paths/#legal', tint: 'law', icon: 'M12 3v18M5 21h14M6 7h12M4 7l-2 6a3 3 0 0 0 6 0zM20 7l-2 6a3 3 0 0 0 4 0z' },
  { t: 'I study business informatics', d: 'Model processes as state machines, price transactions and judge when a blockchain is worth it.', chips: ['Product path', 'Light code'], href: '/paths/#product', tint: 'bi', icon: 'M4 19V5M4 19h16M8 15l4-4 3 3 5-6' },
  { t: 'I study computer science', d: 'Write Solidity, break it on purpose, test it with Foundry and ship it to a public testnet.', chips: ['Developer path', 'Solidity'], href: '/paths/#developer', tint: 'cs', icon: 'm8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14' },
  { t: 'I already work', d: 'Lawyers, analysts and engineers who need the essentials fast. Take the placement check and skip what you know.', chips: ['Self-paced', 'Pick modules'], href: '/placement/', tint: 'brand', icon: 'M3 7h18v13H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' },
];
---
<Base title="Contract Commons">
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <span class="hero-badge"><i></i>Free · in your browser · testnet only</span>
        <h1>Learn smart contracts the way they are used: in code, in business and in law.</h1>
        <p>An Ethereum-focused course for computer science, business informatics and law students. Build real contracts in Remix, use the tools professionals use, and learn to ask the questions that code cannot answer.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a class="cc-btn cc-btn--accent" href={url('/curriculum/')}>Start the course
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a class="cc-btn cc-btn--ghost-dark" href="#start">Find your starting point</a>
        </div>
        <div class="hero-stats">
          <div><b>{MODULES.length}</b>modules</div>
          <div><b>{lessons.length}</b>lessons and labs</div>
          <div><b>{codeLabs}</b>code labs</div>
          <div><b>{toolLabs}</b>labs with market tools</div>
          <div><b>0 €</b>real money, ever</div>
        </div>
      </div>
      <div class="hero-visual" aria-label="Example: an escrow contract in lab 4.3">
        <div class="float-card">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <div><div class="cc-eyebrow" style="color:var(--muted-2)">Lab 4.3 · Escrow</div><div style="font-size:19px;font-weight:700">Laptop purchase, 1 ETH</div></div>
            <span class="cc-chip cc-chip--pending">Awaiting delivery</span>
          </div>
          <ol class="cc-states" style="margin-top:18px">
            <li data-s="done"><small>Done</small><b>Payment held</b></li>
            <li data-s="now"><small>Now</small><b>Delivery</b></li>
            <li><small>Next</small><b>Released</b></li>
          </ol>
          <div style="margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px">
            <div style="border:1px solid var(--line);border-radius:12px;padding:10px 12px"><div style="font-size:12px;color:var(--muted-2)">Buyer</div><div style="font:500 12.5px var(--font-mono)">0x5B38…eddC4</div></div>
            <div style="border:1px solid var(--line);border-radius:12px;padding:10px 12px"><div style="font-size:12px;color:var(--muted-2)">Seller</div><div style="font:500 12.5px var(--font-mono)">0xAb84…35cb2</div></div>
            <div style="border:1px solid var(--line);border-radius:12px;padding:10px 12px"><div style="font-size:12px;color:var(--muted-2)">Arbiter</div><div style="font:500 12.5px var(--font-mono)">0x4B20…C02db</div></div>
          </div>
          <div class="cc-callout cc-callout--law" style="margin-top:14px;flex-direction:column;gap:4px">
            <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--law-600)"><span>§4 Release · legal text</span><span style="font-family:var(--font-mono);text-transform:none;letter-spacing:0">→ confirmDelivery()</span></div>
            <div>When the Buyer or the Arbiter confirms delivery, the payment is released to the Seller.</div>
          </div>
        </div>
        <div class="toast">
          <span class="cc-icon-tile" style="width:32px;height:32px;border-radius:10px;background:var(--danger-100);color:var(--danger-700)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/></svg></span>
          <div><div style="font-size:14px;font-weight:700">Seller tried to release the payment</div><div style="font:500 12.5px var(--font-mono);color:var(--danger-700)">revert: “Only buyer or arbiter”</div><div style="font-size:13px;color:var(--muted-2)">The contract enforced §4. That is the lesson.</div></div>
        </div>
      </div>
    </section>

    <section class="section" id="start">
      <div class="section-head">
        <div><div class="cc-eyebrow">Start where you are</div><h2>One course, four ways in</h2><p>Pick the card that sounds like you. The 10-question placement check then marks where to start.</p></div>
        <a class="more" href={url('/placement/')}>Take the placement check →</a>
      </div>
      <div class="grid grid-sm">
        {personas.map((p) => (
          <a class="cc-card card-link" href={url(p.href)}>
            <span class={`cc-icon-tile cc-icon-tile--${p.tint}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.icon}/></svg></span>
            <div><h3>{p.t}</h3><p style="margin-top:6px">{p.d}</p></div>
            <div class="meta-chips" style="margin-top:auto">{p.chips.map((c) => <span class="cc-chip">{c}</span>)}</div>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="panel">
        <div class="cc-eyebrow">How every lesson works</div>
        <h2 style="font-size:34px;letter-spacing:-.02em;font-weight:800;margin:10px 0 28px;max-width:720px">Five steps, always in the same order, so you always know what comes next</h2>
        <ol class="steps5">{steps.map(([n, t, d]) => <li><span class="n">{n}</span><b>{t}</b><span>{d}</span></li>)}</ol>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><div class="cc-eyebrow">Curriculum</div><h2>From first hash to your own DAO</h2><p>Thirteen Ethereum-focused modules, built from the roadmap.sh blockchain roadmap and syllabi of Stanford, Princeton, MIT, Zurich and Singapore Management University.</p></div>
        <a class="more" href={url('/curriculum/')}>See the full curriculum →</a>
      </div>
      <div class="grid">
        {MODULES.map((m) => {
          const lab = firstLab(m.n);
          return (
            <a class="mod-card" href={url(`/modules/${m.slug}/`)}>
              <span class={`mod-num ${TINT[m.tint]}`}>{String(m.n).padStart(2, '0')}</span>
              <span style="min-width:0"><b>{m.title}</b><span class="d">{m.summary}</span>{lab && <span class="c">Lab: {lab.entry.data.title}</span>}</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><div class="cc-eyebrow">Learning paths</div><h2>Where the course can take you</h2></div><a class="more" href={url('/paths/')}>Compare paths →</a></div>
      <div class="grid">
        {PATHS.map((p) => (
          <a class={`path-card ${p.tint}`} href={url(`/paths/#${p.id}`)}>
            <h3>{p.title}</h3><p>{p.text}</p><span class="k">{p.modules.length} modules · {p.tools}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="panel" style="display:flex;flex-wrap:wrap;gap:40px;align-items:center">
        <div style="flex:1 1 340px;min-width:0">
          <div class="cc-eyebrow">Labs and tools</div>
          <h2 style="font-size:32px;letter-spacing:-.02em;font-weight:800;margin:10px 0 10px">The tools professionals use, on a free test network</h2>
          <p style="margin:0;color:var(--muted)">Every lab runs on Sepolia or reads public data. Your course wallet never holds real money.</p>
          <a class="cc-btn cc-btn--secondary" style="margin-top:18px" href={url('/labs/')}>Browse all labs</a>
        </div>
        <div style="flex:1 1 520px;min-width:0;display:flex;flex-wrap:wrap;gap:10px">
          {tools.map(([n, u]) => <span class="tool-chip"><b>{n}</b><span>{u}</span></span>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="cta-band">
        <div><h2>Run your first contract in 20 minutes</h2><p>No sign-up needed. Your progress is saved in this browser.</p></div>
        <a class="cc-btn cc-btn--primary" href={url('/lessons/lab-remix-tour/')}>Open the Remix tour</a>
      </div>
    </section>
  </div>
</Base>
