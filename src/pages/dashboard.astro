---
import Base from '../layouts/Base.astro';
import { MODULES, orderedLessons, url } from '../lib/course';
const lessons = (await orderedLessons()).map((l) => ({ id: l.entry.id, title: l.entry.data.title, code: l.code, mod: l.mod.n, kind: l.entry.data.kind, minutes: l.entry.data.minutes || '' }));
const data = { lessons, modules: MODULES.map((m) => ({ n: m.n, slug: m.slug, title: m.title, lessons: m.lessons })) };
---
<Base title="My progress" active="">
  <div class="wrap wrap-wide">
    <div class="app-shell">
      <aside class="app-side">
        <nav aria-label="Learner">
          <a href={url('/dashboard/')} aria-current="page">Home</a>
          <a href={url('/curriculum/')}>Curriculum</a>
          <a href={url('/final-exam/')}>Final exam</a>
          <a href={url('/labs/')}>Labs</a>
          <a href="#lablog">Lab log</a>
          <a href={url('/glossary/')}>Glossary</a>
          <a href={url('/teamwork/')}>My team</a>
        </nav>
        <div style="margin-top:auto;background:var(--surface-muted);border-radius:16px;padding:16px">
          <div style="font-size:13px;font-weight:700;color:var(--brand-700)">Course wallet</div>
          <div style="font-size:13.5px;color:var(--muted);margin-top:4px">Sepolia test network only. Never store a recovery phrase here or anywhere online.</div>
          <a href={url('/setup/')} style="font-size:13.5px;font-weight:700">Setup and safety →</a>
        </div>
      </aside>
      <div class="app-main" id="dash">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap">
          <div><div class="cc-eyebrow">My progress</div><h1 style="font-size:32px;letter-spacing:-.02em;font-weight:800;margin:6px 0 0">Welcome back</h1></div>
        </div>
        <section class="path-hero">
          <div style="flex:1 1 360px;min-width:0">
            <span class="hero-badge">One course · same final exam for everyone</span>
            <h2 data-d-next-title>Up next</h2>
            <p data-d-next-sub>Start with Module 1.</p>
            <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="cc-btn cc-btn--accent" href={url('/curriculum/')} data-d-next-link>Continue</a><a class="cc-btn cc-btn--ghost-dark" href={url('/final-exam/')}>Final exam</a></div>
          </div>
          <div class="path-box">
            <div style="display:flex;justify-content:space-between;font-size:13.5px;color:var(--on-brand-muted)"><span>Course progress</span><b style="color:var(--on-brand)" data-d-path-count>0 of 0 modules</b></div>
            <div class="cc-progress"><span data-d-path-bar style="width:0%"></span></div>
            <ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:14px" data-d-path-list></ol>
          </div>
        </section>
        <div class="grid grid-sm" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
          <div class="cc-stat"><span class="cc-icon-tile cc-icon-tile--cs" style="width:44px;height:44px;font-weight:800;font-size:13px">LS</span><div><div class="cc-stat__label">Units completed</div><div class="cc-stat__value" data-d-done>0</div><div class="cc-stat__note" data-d-done-note></div></div></div>
          <div class="cc-stat"><span class="cc-icon-tile cc-icon-tile--brand" style="width:44px;height:44px;font-weight:800;font-size:13px">LB</span><div><div class="cc-stat__label">Labs completed</div><div class="cc-stat__value" data-d-labs>0</div><div class="cc-stat__note" data-d-labs-note></div></div></div>
          <div class="cc-stat"><span class="cc-icon-tile cc-icon-tile--law" style="width:44px;height:44px;font-weight:800;font-size:13px">QZ</span><div><div class="cc-stat__label">Quiz average</div><div class="cc-stat__value" data-d-quiz>–</div><div class="cc-stat__note">Lesson pass mark 80%</div></div></div>
          <div class="cc-stat"><span class="cc-icon-tile cc-icon-tile--bi" style="width:44px;height:44px;font-weight:800;font-size:13px">LG</span><div><div class="cc-stat__label">Lab log entries</div><div class="cc-stat__value" data-d-logs>0</div><div class="cc-stat__note">Saved in this browser</div></div></div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:18px;align-items:flex-start">
          <section style="flex:999 1 520px;min-width:0;display:flex;flex-direction:column;gap:18px">
            <div>
              <h2 style="font-size:19px;font-weight:800;margin:0 0 12px">Continue learning</h2>
              <div class="grid" data-d-continue></div>
            </div>
            <section class="cc-card" id="lablog">
              <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
                <h2 style="font-size:19px;font-weight:800;margin:0">Lab log</h2>
                <button class="cc-btn cc-btn--secondary" type="button" data-export>Copy lab log as text</button>
              </div>
              <div class="table-box" data-d-log></div>
              <span data-export-status style="font-size:14px;color:var(--brand-700);font-weight:600" aria-live="polite"></span>
            </section>
          </section>
          <section class="cc-card" style="flex:1 1 300px;min-width:0">
            <h2 style="font-size:19px;font-weight:800;margin:0 0 12px">Modules</h2>
            <ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px" data-d-mods></ol>
            <div style="border-top:1px solid var(--line);margin-top:14px;padding-top:14px;display:flex;gap:10px;flex-wrap:wrap">
              <a class="cc-btn cc-btn--secondary" href={url('/final-exam/')}>Final exam</a>
              <button class="cc-btn cc-btn--secondary" type="button" data-reset>Reset progress</button>
            </div>
            <p data-reset-confirm hidden style="font-size:14px;margin:10px 0 0">Delete all progress and lab log entries in this browser? <button class="cc-btn cc-btn--primary" type="button" data-reset-yes style="min-height:36px">Yes, reset</button> <button class="cc-btn cc-btn--secondary" type="button" data-reset-no style="min-height:36px">Cancel</button></p>
          </section>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="course-data" set:html={JSON.stringify(data)} />
</Base>
